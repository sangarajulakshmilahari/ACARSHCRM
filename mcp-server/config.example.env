# Copy this file to mcp-server/config.env and set the database password.
ACARSH_MCP_DB_HOST=127.0.0.1
ACARSH_MCP_DB_PORT=3306
ACARSH_MCP_DB_USER=acarsh_mcp
ACARSH_MCP_DB_PASSWORD=replace-me
ACARSH_MCP_DB_NAME=acarsh_db

# Required together for direct/STDIO use. HTTP callers supply a trusted actor instead.
# Company id is required; STDIO never selects a default membership.
# ACARSH_MCP_DEFAULT_ACTOR_USER_ID=1
# ACARSH_MCP_DEFAULT_ACTOR_ROLE_ID=1
# ACARSH_MCP_DEFAULT_ACTOR_COMPANY_ID=1

# Required for HTTP transport. Use the same random value in the Next.js .env.
ACARSH_MCP_INTERNAL_TOKEN=replace-with-a-long-random-secret

ACARSH_MCP_TRANSPORT=http
ACARSH_MCP_HOST=127.0.0.1
ACARSH_MCP_PORT=8000
ACARSH_MCP_HTTP_PATH=/mcp
ACARSH_MCP_MAX_PAGE_SIZE=100
ACARSH_MCP_QUERY_TIMEOUT_SECONDS=15
ACARSH_MCP_INPUT_TIMEZONE=Asia/Kolkata
ACARSH_MCP_LOG_LEVEL=INFO
